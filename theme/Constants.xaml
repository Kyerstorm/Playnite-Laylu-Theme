<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Laylu options, exposed through thememodifier.yaml -->
    <sys:Boolean x:Key="LayluTopBarAutoHide">True</sys:Boolean>
    <sys:Boolean x:Key="LayluRoundedCovers">True</sys:Boolean>
    <CornerRadius x:Key="LayluCoverCornerRadius">6</CornerRadius>
    <sys:Boolean x:Key="LayluPerformanceMode">False</sys:Boolean>
    <sys:Boolean x:Key="LayluReduceMotion">False</sys:Boolean>
    <sys:Boolean x:Key="LayluCardPlayButton">True</sys:Boolean>
    <sys:Boolean x:Key="LayluCardGlow">True</sys:Boolean>
    <sys:Boolean x:Key="LayluCardFavouriteMark">False</sys:Boolean>
    <sys:Boolean x:Key="LayluUseLogo">True</sys:Boolean>
    <sys:Boolean x:Key="LayluTrailerFade">True</sys:Boolean>

    <!-- Laylu tone steps: Base #000000, Surface 1 #0B0B0C, Surface 2 #141416 (inputs), Surface 3 #1D1D20 (popups), hover #26262A, selected #323237 -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">#FFE8E4DC</Color>
    <Color x:Key="TextColorDarker">#FF9A968E</Color>
    <Color x:Key="TextColorDark">#FF000000</Color>
    <Color x:Key="MainColor">#FF323237</Color>
    <Color x:Key="MainColorDark">#FF0B0B0C</Color>
    <Color x:Key="HoverColor">#FF26262A</Color>
    <Color x:Key="GlyphColor">#FFE8E4DC</Color>
    <Color x:Key="HighlightGlyphColor">#66E8E4DC</Color>
    <Color x:Key="PopupBackgroundColor">#FF1D1D20</Color>
    <Color x:Key="PopupBorderColor">#00000000</Color>
    <Color x:Key="BackgroundToneColor">#FF26262A</Color>
    <Color x:Key="GridItemBackgroundColor">#FF141416</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">#00000000</Color>
    <Color x:Key="DataChangeNotifColor">#FFD9A441</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource BackgroundToneColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF141416" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF141416" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="#FF5FB37A" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="#FFD9655B" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="#FFD9A441" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FFD9655B" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="#FF141416" />

    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="#FF000000" />
</ResourceDictionary>
