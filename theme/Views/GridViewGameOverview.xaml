<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Laylu: the grid view's details panel. GENERATED by tools\sync-grid-page.ps1 from
         Views\DetailsViewGameOverview.xaml; edit that file and run the script, not this one.
         Differences from the Details page: no cover image, and Extra Metadata Loader's standard
         video player (the fixed variants only play while Details is the active view), so sound and
         the player's control bar follow the extension's own settings here. -->
    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1400"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
                            <!-- Hero: the whole background image at page width, fading into the base colour -->
                            <!-- The artwork stays in place under the trailer, so a trailer that has not loaded
                                 (or cannot play) leaves the artwork visible instead of a black area -->
                            <Grid>
                            <FadeImage x:Name="PART_ImageBackground" Stretch="Uniform"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <FadeImage.ImageOpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.45" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </FadeImage.ImageOpacityMask>
                            </FadeImage>
                            <!-- ImageRotater: its rotating background (still, GIF or video) drawn over the native
                                 artwork. It draws nothing for a game it has no artwork for, so the artwork above
                                 shows through. Held to the artwork's place (16:9 at page width, top of the page)
                                 and given the same fade, since the extension's control would otherwise stretch
                                 over the whole page -->
                            <Grid VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True"
                                  Height="{Binding ActualHeight, ElementName=LayluVideoShape}">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.45" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <ContentControl x:Name="ImageRotater_Background"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                Focusable="False" IsTabStop="False" />
                            </Grid>
                            </Grid>

                            <Grid HorizontalAlignment="Stretch">
                                <!-- Content is in the middle column: it uses the whole page up to 1500 wide plus
                                     margins, and on a wider page the two side columns share what is left, centring it -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1000*" MaxWidth="1564" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <!-- How much of the hero shows above the band: Playnite's "game details indentation"
                                         setting, but never less than 340 so the page always has a hero -->
                                    <RowDefinition Height="{Settings CalculatedGameDetailsIndentation}"
                                                   MinHeight="{Binding ActualHeight, ElementName=LayluHeroSizer}"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Works out the least height of the hero row. Nothing here is drawn and, being in a
                                     Canvas, none of it takes space. Without a trailer the result is 340. With one, the
                                     trailer area (hero plus band) takes the video's own 16:9 shape at page width, so
                                     nothing is cropped, but the hero never exceeds 68% of the visible page height -->
                                <Canvas Grid.Row="0" IsHitTestVisible="False">
                                    <!-- LayluHeroCap: 68% of the visible page height while a trailer shows, else 0 -->
                                    <Grid Width="1">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=LayluTrailerHero}" Value="Visible">
                                                        <Setter Property="Height" Value="{Binding ActualHeight, ElementName=PART_ScrollViewHost}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="68*" />
                                            <RowDefinition Height="32*" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="LayluHeroCap" Grid.Row="0" />
                                    </Grid>
                                    <!-- LayluVideoShape: a 16:9 shape scaled to the page width; its height is the video's -->
                                    <Viewbox x:Name="LayluVideoShape" Stretch="Uniform"
                                             Width="{Binding ActualWidth, ElementName=PART_ScrollViewHost}">
                                        <Rectangle Width="16" Height="9" />
                                    </Viewbox>
                                    <!-- Video height minus the band's height is left for the hero; then capped and floored -->
                                    <DockPanel x:Name="LayluHeroSlot" Width="1" Height="{Binding ActualHeight, ElementName=LayluVideoShape}">
                                        <Border DockPanel.Dock="Bottom" Height="{Binding ActualHeight, ElementName=HeaderBand}" />
                                        <Border x:Name="LayluHeroSizer" MinHeight="340"
                                                MaxHeight="{Binding ActualHeight, ElementName=LayluHeroCap}" />
                                    </DockPanel>
                                </Canvas>

                                <!-- Trailer hero (Extra Metadata Loader): the player variant with no controls and no sound,
                                     scaled and cropped to fill the hero and the band in front of it.
                                     Absent when the game has no video or the video player is turned off -->
                                <Grid x:Name="LayluTrailerHero" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
                                      Tag="{DynamicResource LayluPerformanceMode}"
                                      ClipToBounds="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True" />
                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}" Value="True" />
                                                        <!-- Tag carries performance mode: no trailer when it is on -->
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- A Canvas asks for no space, so the video's own height cannot stretch the band's row;
                                         the trailer just takes the size of the hero plus the band -->
                                    <Canvas x:Name="LayluTrailerCanvas">
                                    <Grid Width="{Binding ActualWidth, ElementName=LayluTrailerCanvas}"
                                          Height="{Binding ActualHeight, ElementName=LayluTrailerCanvas}">
                                    <Grid IsHitTestVisible="False">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="0.8" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <!-- No backing colour: until the player draws a frame, the artwork behind shows through -->
                                        <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl"
                                                        Focusable="False">
                                            <ContentControl.Template>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <Viewbox Stretch="UniformToFill">
                                                        <ContentPresenter />
                                                    </Viewbox>
                                                </ControlTemplate>
                                            </ContentControl.Template>
                                        </ContentControl>
                                    </Grid>
                                    <!-- The player has no controls of its own, so play and pause sit in the corner -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"
                                            Background="#99000000" Padding="10,2,10,2"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                    Style="{DynamicResource SimpleButton}" ToolTip="Play trailer"
                                                    Command="{Binding Content.VideoPlayCommand, ElementName=ExtraMetadataLoader_VideoLoaderControl, FallbackValue={x:Null}}" />
                                            <Button Content="&#x23F8;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                    Style="{DynamicResource SimpleButton}" ToolTip="Pause trailer" Margin="12,3,0,3"
                                                    Command="{Binding Content.VideoPauseCommand, ElementName=ExtraMetadataLoader_VideoLoaderControl, FallbackValue={x:Null}}" />
                                        </StackPanel>
                                    </Border>
                                    </Grid>
                                    </Canvas>
                                </Grid>

                                <!-- Logo title (Extra Metadata Loader), on the hero just above the band -->
                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"
                                                Grid.Row="0" Grid.Column="1" Focusable="False"
                                                Tag="{DynamicResource LayluUseLogo}"
                                                Opacity="{Binding Opacity, ElementName=HeaderBand}"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Margin="32,0,32,18" MaxHeight="220">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="True" />
                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="True" />
                                                        <!-- Tag carries the "use logo" option -->
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!-- Glass band: title, actions and the stats strip -->
                                <Border x:Name="HeaderBand" Grid.Row="1" Grid.ColumnSpan="3" Background="#B3000000"
                                        Tag="{DynamicResource LayluTrailerFade}">
                                    <!-- Trailer fade: ten seconds into playback the band (and the logo, which copies
                                         its opacity) dims. It returns when playback stops, when the pointer is over
                                         the band, or when the keyboard is in it. Tag carries the option -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding Visibility, ElementName=LayluTrailerHero}" Value="Visible" />
                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying, FallbackValue=False}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0.1" BeginTime="0:0:10" Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- A WrapPanel: the stats sit beside the title and actions when there is room,
                                         and drop onto their own line when there is not -->
                                    <WrapPanel HorizontalAlignment="Center" Margin="32,18,32,18"
                                               Width="{Binding ActualWidth, ElementName=LayluBodyGrid}">

                                        <StackPanel VerticalAlignment="Center">
                                            <!-- Text title. Hidden when Extra Metadata Loader shows a logo for this game -->
                                            <DockPanel Tag="{DynamicResource LayluUseLogo}">
                                                <DockPanel.Style>
                                                    <Style TargetType="DockPanel">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DockPanel.Style>
                                                <Image Name="PART_ImageIcon" MaxHeight="44" MaxWidth="44"
                                                       DockPanel.Dock="Left" Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                                <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                           DockPanel.Dock="Left"
                                                           FontSize="{DynamicResource FontSizeLargest}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button Name="PART_ButtonPlayAction"
                                                        Width="170" Height="40" Style="{DynamicResource PlayButton}" />
                                                <Button Name="PART_ButtonContextAction"
                                                        Width="170" Height="40" />
                                                <Button Name="PART_ButtonMoreActions"
                                                        Content="{DynamicResource LOCMoreAction}"
                                                        Width="130" Height="40" Margin="10,0,0,0" />
                                                <!-- In-place editing (ThemeExtras): favourite, completion status, user rating.
                                                     The whole group is absent without the extension -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                                            Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}">
                                                    <ContentControl x:Name="ThemeExtras_SettableFavorite" Cursor="Hand"
                                                                    VerticalAlignment="Center" Focusable="False"
                                                                    ToolTip="Favourite">
                                                        <ContentControl.Resources>
                                                            <Style TargetType="UserControl">
                                                                <Setter Property="Content">
                                                                    <Setter.Value>
                                                                        <CheckBox IsChecked="{Binding Value}">
                                                                            <CheckBox.Template>
                                                                                <ControlTemplate TargetType="CheckBox">
                                                                                    <Border Background="Transparent" Padding="6,0,6,0">
                                                                                        <TextBlock x:Name="Star" Text="&#x2605;"
                                                                                                   FontFamily="Segoe UI Symbol" FontSize="24"
                                                                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsChecked" Value="True">
                                                                                            <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </CheckBox.Template>
                                                                        </CheckBox>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ContentControl.Resources>
                                                    </ContentControl>
                                                    <ContentControl x:Name="ThemeExtras_SettableCompletionStatus" Width="170"
                                                                    Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False"
                                                                    ToolTip="{DynamicResource LOCCompletionStatus}">
                                                        <ContentControl.Resources>
                                                            <Style TargetType="UserControl">
                                                                <Setter Property="Content">
                                                                    <Setter.Value>
                                                                        <ComboBox ItemsSource="{Binding CompletionStatusOptions}"
                                                                                  SelectedItem="{Binding Value}"
                                                                                  DisplayMemberPath="Name" Height="32" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ContentControl.Resources>
                                                    </ContentControl>
                                                    <ContentControl x:Name="ThemeExtras_UserRating" Margin="14,0,0,0"
                                                                    VerticalAlignment="Center" Focusable="False" />
                                                </StackPanel>
                                                <Button x:Name="PART_ButtonEditGame"
                                                        Margin="10,0,0,0" Height="40" Focusable="False"
                                                        Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=HeaderBand}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Stats strip. Playnite hides each PART_Elem cell the game has no value for -->
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="10,8,0,8">
                                            <StackPanel Name="PART_ElemPlayTime" Margin="14,0,14,0">
                                                <TextBlock Name="PART_TextPlayTime" Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}" />
                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <StackPanel Name="PART_ElemLastPlayed" Margin="14,0,14,0">
                                                <TextBlock Name="PART_TextLastActivity" Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}" />
                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <StackPanel Name="PART_ElemRecentActivity" Margin="14,0,14,0">
                                                <TextBlock Name="PART_TextRecentActivity" Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}" />
                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <!-- Scores are shown out of 10, so they use their own text instead of PART_Text...Score -->
                                            <StackPanel Name="PART_ElemCommunityScore" Margin="14,0,14,0">
                                                <TextBlock Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                           Text="{Binding Game.CommunityScore, Converter={StaticResource MathConverter}, ConverterParameter=x/10}" />
                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <StackPanel Name="PART_ElemCriticScore" Margin="14,0,14,0">
                                                <TextBlock Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                           Text="{Binding Game.CriticScore, Converter={StaticResource MathConverter}, ConverterParameter=x/10}" />
                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <StackPanel Name="PART_ElemUserScore" Margin="14,0,14,0">
                                                <TextBlock Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                           Text="{Binding Game.UserScore, Converter={StaticResource MathConverter}, ConverterParameter=x/10}" />
                                                <TextBlock Text="{DynamicResource LOCUserScore}" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <!-- Time to beat (HowLongToBeat), main story -->
                                            <StackPanel Margin="14,0,14,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Style="{StaticResource LayluStatValue}"
                                                           FontSize="{DynamicResource FontSizeLarger}"
                                                           Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='-'}" />
                                                <TextBlock Text="Time to Beat" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <!-- Achievements (Playnite Achievements), unlocked / total -->
                                            <StackPanel Margin="14,0,14,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.HasAchievements, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource LayluStatValue}"
                                                               FontSize="{DynamicResource FontSizeLarger}"
                                                               Text="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.UnlockedCount, FallbackValue='-'}" />
                                                    <TextBlock Style="{StaticResource LayluStatValue}"
                                                               FontSize="{DynamicResource FontSizeLarger}" Text="/" />
                                                    <TextBlock Style="{StaticResource LayluStatValue}"
                                                               FontSize="{DynamicResource FontSizeLarger}"
                                                               Text="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.AchievementCount, FallbackValue='-'}" />
                                                </StackPanel>
                                                <TextBlock Text="Achievements" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                            <!-- Players online right now (Universal Steam Player Count); the extension draws the number -->
                                            <StackPanel Margin="14,0,14,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamPlayerCount, Path=PlayerCountAvailable, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ContentControl x:Name="SteamPlayerCount_PlayerCountControl" Focusable="False"
                                                                HorizontalAlignment="Center">
                                                    <!-- The extension's element is a Button. Here it is drawn as plain text,
                                                         the same as the other stat values; it stays clickable -->
                                                    <ContentControl.Resources>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Focusable" Value="False" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent">
                                                                            <TextBlock Style="{StaticResource LayluStatValue}"
                                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ContentControl.Resources>
                                                </ContentControl>
                                                <TextBlock Text="Playing Now" Style="{StaticResource LayluStatCaption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Body: cover and fields on the left, links and tabs on the right -->
                                <Grid x:Name="LayluBodyGrid" Grid.Row="2" Grid.Column="1" Margin="32,22,32,32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ItemsPanel" Value="{StaticResource LayluWrapItemsPanel}" />
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Margin" Value="0,0,14,0" />
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                            <Setter Property="Margin" Value="0,4,12,4" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                        </Style>
                                    </Grid.Resources>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                        </StackPanel.Resources>


                                        <GridEx Margin="0,0,0,8"
                                                ColumnCount="2" StarColumns="1"
                                                RowCount="12" AutoLayoutColumns="2">
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                            </Grid.Resources>

                                            <Label Name="PART_ElemCompletionStatus" Content="{DynamicResource LOCCompletionStatus}" />
                                            <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemPlatform" Content="{DynamicResource LOCPlatformTitle}" />
                                            <ItemsControl Name="PART_ItemsPlatforms" />

                                            <Label Name="PART_ElemGenres" Content="{DynamicResource LOCGenreLabel}" />
                                            <ItemsControl Name="PART_ItemsGenres"  />

                                            <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                            <ItemsControl Name="PART_ItemsDevelopers" />

                                            <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                            <ItemsControl Name="PART_ItemsPublishers" />

                                            <Label Name="PART_ElemReleaseDate" Content="{DynamicResource LOCGameReleaseDateTitle}" />
                                            <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemCategories" Content="{DynamicResource LOCGameCategoriesTitle}" />
                                            <ItemsControl Name="PART_ItemsCategories" />

                                            <Label Name="PART_ElemLibrary" Content="{DynamicResource LOCGameProviderTitle}" />
                                            <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" />

                                            <Label Name="PART_ElemAdded" Content="{DynamicResource LOCDateAddedLabel}" />
                                            <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />

                                            <Label Name="PART_ElemInstallSize" Content="{DynamicResource LOCInstallSizeLabel}" />
                                            <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </GridEx>

                                        <Expander Header="{DynamicResource LOCMoreAction}" IsExpanded="False">
                                            <GridEx Margin="0,6,0,0"
                                                    ColumnCount="2" StarColumns="1"
                                                    RowCount="10" AutoLayoutColumns="2">
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                </Grid.Resources>

                                                <Label Name="PART_ElemTags" Content="{DynamicResource LOCTagsLabel}" />
                                                <ItemsControl Name="PART_ItemsTags" />

                                                <Label Name="PART_ElemFeatures" Content="{DynamicResource LOCFeaturesLabel}" />
                                                <ItemsControl Name="PART_ItemsFeatures" />

                                                <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                <ItemsControl Name="PART_ItemsSeries" />

                                                <Label Name="PART_ElemAgeRating" Content="{DynamicResource LOCAgeRatingLabel}" />
                                                <ItemsControl Name="PART_ItemsAgeRatings" />

                                                <Label Name="PART_ElemRegion" Content="{DynamicResource LOCRegionLabel}" />
                                                <ItemsControl Name="PART_ItemsRegions" />

                                                <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                                <Button Name="PART_ButtonSource" VerticalAlignment="Center" />

                                                <Label Name="PART_ElemVersion" Content="{DynamicResource LOCVersionLabel}" />
                                                <Button Name="PART_ButtonVersion" VerticalAlignment="Center" />

                                                <Label Name="PART_ElemInstallDirectory" Content="{DynamicResource LOCGameInstallDirTitle}" />
                                                <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" />
                                            </GridEx>
                                        </Expander>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="32,0,0,0">
                                        <!-- Link chips. A ListBox, not an ItemsControl, so the theme controls the item
                                             container and can draw each link as a chip -->
                                        <StackPanel Name="PART_ElemLinks" Margin="0,0,0,10">
                                            <!-- Links with site icons (ThemeExtras). When it is installed, the plain list below is hidden -->
                                            <ContentControl x:Name="ThemeExtras_Links" Focusable="False" HorizontalAlignment="Left"
                                                            Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}">
                                                <ContentControl.Resources>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="ItemsPanel" Value="{StaticResource LayluWrapItemsPanel}" />
                                                        <Setter Property="ItemTemplate" Value="{StaticResource LayluLinkChipTemplate}" />
                                                    </Style>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=ThemeExtras_Links}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            <ListBox Name="PART_ItemsLinks" Focusable="False" HorizontalAlignment="Left"
                                                     ItemsPanel="{StaticResource LayluWrapItemsPanel}">
                                                <ListBox.Template>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <ItemsPresenter />
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Margin" Value="0,0,6,6" />
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                            Padding="10,4,10,4">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Tabs. Each extension tab is absent when its extension is missing or has nothing for the game -->
                                        <TabControl>
                                            <TabItem Header="{DynamicResource LOCOverviewLabel}">
                                                <StackPanel Name="PART_ElemDescription" Margin="0,14,0,0">
                                                    <HtmlTextView Name="PART_HtmlDescription"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{DynamicResource TextColor}"
                                                                  LinkForeground="{DynamicResource GlyphColor}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                            </TabItem>
                                            <!-- Notes: Playnite's own notes field and the PlayNotes extension's notes.
                                                 The tab shows when either has something for this game -->
                                            <TabItem Header="{DynamicResource LOCNotesLabel}">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayNotes, Path=IsControlVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <StackPanel Margin="0,14,0,0">
                                                    <StackPanel Name="PART_ElemNotes">
                                                        <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                                 BorderThickness="0"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 Padding="8"/>
                                                    </StackPanel>
                                                    <ContentControl x:Name="PlayNotes_NotesViewerControl" Margin="0,10,0,0">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=PlayNotes, Path=IsControlVisible, FallbackValue=False}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </StackPanel>
                                            </TabItem>
                                            <!-- Media: screenshots (Screenshot Utilities) and trailer (Extra Metadata Loader).
                                                 The tab shows when either has something for this game -->
                                            <TabItem Header="Media">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ScreenshotUtilities, Path=IsViewerControlVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <StackPanel Margin="0,14,0,0">
                                                    <ContentControl x:Name="ScreenshotUtilities_ScreenshotViewerControl" VerticalAlignment="Top">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=ScreenshotUtilities, Path=IsViewerControlVisible, FallbackValue=False}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </StackPanel>
                                            </TabItem>

                                            <!-- Achievements (Playnite Achievements) -->
                                            <TabItem Header="Achievements">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <!-- The right margin is for the list's "Captures" header: the extension makes that
                                                     column 56 wide, narrower than the word, and lets the header draw past the
                                                     column's edge. Without room on the right, the last letter is cut off -->
                                                <StackPanel Margin="0,14,8,0">
                                                    <ContentControl x:Name="PlayniteAchievements_PluginProgressBar" />
                                                    <ContentControl x:Name="PlayniteAchievements_PluginCompactUnlocked" Margin="0,10,0,0" />
                                                    <ContentControl x:Name="PlayniteAchievements_PluginCompactLocked" Margin="0,10,0,0" />
                                                    <ContentControl x:Name="PlayniteAchievements_PluginUserStats" Margin="0,10,0,0" />
                                                    <!-- The extension's newer list. Its older one (PlayniteAchievements_PluginList) sizes
                                                         each row's text as "list width minus 100" and adds the icon and margins on
                                                         top, so with larger icons every row overflows to the right at any width.
                                                         A fixed height, because inside this StackPanel it would otherwise grow to
                                                         show every achievement at once -->
                                                    <ContentControl x:Name="PlayniteAchievements_AchievementDataGrid"
                                                                    Margin="0,10,0,0" Height="600" />
                                                    <!-- Unlocks over time. The control sets its own height (200) -->
                                                    <ContentControl x:Name="PlayniteAchievements_AchievementBarChart" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </TabItem>

                                            <!-- Activity: play-time chart (GameActivity) and time-to-beat bar (HowLongToBeat) -->
                                            <TabItem Header="Activity">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=GameActivity, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <StackPanel Margin="0,14,0,0">
                                                    <ContentControl x:Name="HowLongToBeat_PluginProgressBar" Height="40" Margin="0,0,0,14">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=False}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                    <ContentControl x:Name="GameActivity_PluginChartTime">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=GameActivity, Path=HasData, FallbackValue=False}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </StackPanel>
                                            </TabItem>

                                            <!-- News (News Viewer). The extension names this setting ReviewsAvailable, but it is its news flag -->
                                            <TabItem Header="News">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=NewsViewer, Path=ReviewsAvailable, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <ContentControl x:Name="NewsViewer_NewsViewerControl" Margin="0,14,0,0" />
                                            </TabItem>

                                            <!-- Reviews (Review Viewer) -->
                                            <TabItem Header="Reviews">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ReviewViewer, Path=IsControlVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <ContentControl x:Name="ReviewViewer_ReviewsControl" Margin="0,14,0,0" />
                                            </TabItem>

                                            <!-- DLC (CheckDlc). Its lists need a set height; each shows only if switched on in the extension -->
                                            <TabItem Header="DLC">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=CheckDlc, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <StackPanel Margin="0,14,0,0">
                                                    <ContentControl x:Name="CheckDlc_PluginListDlcAll" Height="500" Margin="0,0,0,10"
                                                                    Visibility="{PluginSettings Plugin=CheckDlc, Path=EnableIntegrationListDlcAll, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ContentControl x:Name="CheckDlc_PluginListDlcOwned" Height="500" Margin="0,0,0,10"
                                                                    Visibility="{PluginSettings Plugin=CheckDlc, Path=EnableIntegrationListDlcOwned, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ContentControl x:Name="CheckDlc_PluginListDlcNotOwned" Height="500"
                                                                    Visibility="{PluginSettings Plugin=CheckDlc, Path=EnableIntegrationListDlcNotOwned, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </TabItem>

                                            <!-- Related (Game Relations): up to four rows of covers, each with a caption -->
                                            <TabItem Header="Related">
                                                <TabItem.Style>
                                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=GameRelations, Path=SimilarGamesControlSettings.IsVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=GameRelations, Path=SameSeriesControlSettings.IsVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=GameRelations, Path=SameDeveloperControlSettings.IsVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=GameRelations, Path=SamePublisherControlSettings.IsVisible, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabItem.Style>
                                                <StackPanel Margin="0,14,0,0">
                                                    <StackPanel Margin="0,0,0,18"
                                                                Visibility="{PluginSettings Plugin=GameRelations, Path=SimilarGamesControlSettings.IsVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Similar games" Style="{StaticResource BaseTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,8" />
                                                        <ContentControl x:Name="GameRelations_SimilarGamesControl" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,18"
                                                                Visibility="{PluginSettings Plugin=GameRelations, Path=SameSeriesControlSettings.IsVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Same series" Style="{StaticResource BaseTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,8" />
                                                        <ContentControl x:Name="GameRelations_SameSeriesControl" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,18"
                                                                Visibility="{PluginSettings Plugin=GameRelations, Path=SameDeveloperControlSettings.IsVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Same developer" Style="{StaticResource BaseTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,8" />
                                                        <ContentControl x:Name="GameRelations_SameDeveloperControl" />
                                                    </StackPanel>
                                                    <StackPanel
                                                                Visibility="{PluginSettings Plugin=GameRelations, Path=SamePublisherControlSettings.IsVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Same publisher" Style="{StaticResource BaseTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,8" />
                                                        <ContentControl x:Name="GameRelations_SamePublisherControl" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
