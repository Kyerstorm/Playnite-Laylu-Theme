<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <sys:Boolean x:Key="LayluTrue">True</sys:Boolean>

    <!-- Quick controls at the bottom of the rail. Tag = True marks the active one. -->
    <ControlTemplate x:Key="LayluRailButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Grid>
            <Border Background="{TemplateBinding Background}" />
            <Rectangle x:Name="SelectedBar" Width="3" Height="18"
                       RadiusX="1.5" RadiusY="1.5"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource GlyphBrush}"
                       Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{StaticResource LayluTrue}">
                <Setter Property="Visibility" Value="Visible" TargetName="SelectedBar" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="LayluRailButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template" Value="{StaticResource LayluRailButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource LayluTrue}">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource NormalBrushDark}"
                            x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    Width="56" Height="48" Margin="0,0,0,5"
                                    DockPanel.Dock="Top" Padding="13,9,13,9" Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Image Source="{ThemeFile 'Images/applogo.png'}"
                                       RenderOptions.BitmapScalingMode="Fant" />
                            </Border>

                            <StackPanel x:Name="LayluQuickControls" DockPanel.Dock="Bottom" Margin="0,5,0,8">
                                <ToggleButton IsChecked="{Settings NotificationPanelVisible, Mode=TwoWay}"
                                              ToolTip="{DynamicResource LOCNotifications}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource LayluRailButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Grid>
                                        <TextBlock Text="&#xeea3;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" />
                                        <Border CornerRadius="7" MinWidth="14" Height="14" Margin="12,0,-8,-4" Padding="3,0,3,0"
                                                Background="{DynamicResource WarningBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Api Notifications.Count}" FontSize="10"
                                                       Foreground="{DynamicResource TextBrushDark}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>

                                <ToggleButton IsChecked="{Settings FilterPanelVisible, Mode=TwoWay}"
                                              ToolTip="{DynamicResource LOCFilters}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource LayluRailButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Tag" Value="{StaticResource LayluTrue}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Grid>
                                        <TextBlock Text="&#xef29;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" />
                                        <!-- Shown while any filter is active, so it is visible with the top bar hidden -->
                                        <Ellipse Width="7" Height="7" Margin="0,-2,-6,0"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Fill="{DynamicResource DataChangeNotifBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Settings FilterSettings.IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </ToggleButton>

                                <!-- Reopens the grid details panel. Shown only in Grid view while the panel is closed -->
                                <ToggleButton IsChecked="{Settings GridViewSideBarVisible, Mode=TwoWay}"
                                              ToolTip="{DynamicResource LOCGameDetails}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource LayluRailButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Settings ViewSettings.GamesViewType}" Value="Grid" />
                                                        <Condition Binding="{Settings GridViewSideBarVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="&#xef4f;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" />
                                </ToggleButton>

                                <Button Command="{MainViewModel SwitchGridViewCommand}"
                                        ToolTip="{DynamicResource LOCGridViewLabel}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LayluRailButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ViewSettings.GamesViewType}" Value="Grid">
                                                    <Setter Property="Tag" Value="{StaticResource LayluTrue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE138;" FontFamily="Segoe UI Symbol" FontSize="18" />
                                </Button>

                                <Button Command="{MainViewModel SwitchDetailsViewCommand}"
                                        ToolTip="{DynamicResource LOCDetailsViewLabel}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LayluRailButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ViewSettings.GamesViewType}" Value="Details">
                                                    <Setter Property="Tag" Value="{StaticResource LayluTrue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE145;" FontFamily="Segoe UI Symbol" FontSize="18" />
                                </Button>

                                <Button Command="{MainViewModel SwitchListViewCommand}"
                                        ToolTip="{DynamicResource LOCListViewLabel}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LayluRailButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ViewSettings.GamesViewType}" Value="List">
                                                    <Setter Property="Tag" Value="{StaticResource LayluTrue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE14C;" FontFamily="Segoe UI Symbol" FontSize="18" />
                                </Button>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="Margin" Value="0,0,0,5" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,5,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,100,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayluQuickControls" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,5,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayluQuickControls" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
