<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="DetailsViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border Name="PART_PanelHost" Padding="14,4,10,4" Background="Transparent"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <DockPanel>
                            <Image Name="PART_ImageIcon"
                                   Height="{Settings DetailsViewListIconSize}"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <!-- Marks on the right: favourite, and "not installed" -->
                            <TextBlock x:Name="NotInstalledMark" Text="&#xef08;"
                                       FontFamily="{StaticResource FontIcoFont}"
                                       ToolTip="{DynamicResource LOCGameIsUnInstalledTitle}"
                                       Foreground="{DynamicResource TextBrushDarker}"
                                       VerticalAlignment="Center" DockPanel.Dock="Right"
                                       Margin="6,0,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="FavoriteMark" Text="&#x2605;"
                                       FontFamily="Segoe UI Symbol"
                                       Foreground="{DynamicResource MixedRatingBrush}"
                                       VerticalAlignment="Center" DockPanel.Dock="Right"
                                       Margin="6,0,0,0" Visibility="Collapsed" />
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" DockPanel.Dock="Left">
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Visibility" Value="Visible" TargetName="NotInstalledMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="FavoriteMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
