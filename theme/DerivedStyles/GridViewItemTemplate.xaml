<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:p="clr-namespace:Playnite;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Laylu: outline and glow follow the "rounded covers" option -->
    <Style x:Key="LayluCardShape" TargetType="Border">
        <Setter Property="Tag" Value="{DynamicResource LayluRoundedCovers}" />
        <Setter Property="CornerRadius" Value="{DynamicResource LayluCoverCornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="CornerRadius" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="Transparent">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <Grid Width="{Settings GridItemWidth}"
                                  Height="{Settings GridItemHeight}">
                                <!-- Only the shadow of this black shape is seen. The effect is on a flat
                                     rectangle, not on the cover, and exists only while the card is hovered,
                                     selected or running -->
                                <Border x:Name="Glow" Style="{StaticResource LayluCardShape}"
                                        Background="Black" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6"
                                                          Color="{DynamicResource GlyphColor}" />
                                    </Border.Effect>
                                </Border>

                                <!-- Running: a wider, stronger glow than hover or selection -->
                                <Border x:Name="RunningGlow" Style="{StaticResource LayluCardShape}"
                                        Background="Black" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="1"
                                                          Color="{DynamicResource GlyphColor}" />
                                    </Border.Effect>
                                </Border>

                                <Grid x:Name="CoverHost" Tag="{DynamicResource LayluRoundedCovers}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <!-- Rounded unless performance mode is on -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding Tag, ElementName=BorderMouseOver}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="OpacityMask">
                                                        <Setter.Value>
                                                            <!-- Not in the visual tree, so the size is read from Playnite's settings directly -->
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Border Background="White"
                                                                            CornerRadius="{DynamicResource LayluCoverCornerRadius}"
                                                                            Width="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=AppSettings.GridItemWidth}"
                                                                            Height="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=AppSettings.GridItemHeight}" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Image Name="PART_ImageCover"
                                           RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="{Settings CoverArtStretch}" />
                                    <!-- Missing cover: a plain card that hides Playnite's default image -->
                                    <Border Background="{DynamicResource GridItemBackgroundBrush}"
                                            x:Name="TextGameName" Visibility="Collapsed">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" Margin="10"
                                                   Style="{StaticResource BaseTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Settings ShowNameEmptyCover}" />
                                    </Border>
                                    <!-- ImageRotater: its rotating cover over the native one. Draws nothing for a game it
                                         has no cover for. Inside CoverHost, so it is rounded and dimmed like the cover -->
                                    <ContentControl x:Name="ImageRotater_Cover"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                    <!-- These two also carry an option each in Tag, read by the triggers below,
                                         so no extra element is needed per card: glow on DimOverlay,
                                         performance mode on BorderMouseOver -->
                                    <Border Background="#99000000" x:Name="DimOverlay"
                                            Tag="{DynamicResource LayluCardGlow}"
                                            Visibility="Collapsed" IsHitTestVisible="False" />
                                    <Border Background="#16FFFFFF" x:Name="BorderMouseOver"
                                            Tag="{DynamicResource LayluPerformanceMode}"
                                            Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>

                                <!-- Optional star on favourites; Tag carries the option -->
                                <TextBlock x:Name="FavouriteMark" Tag="{DynamicResource LayluCardFavouriteMark}"
                                           Visibility="Collapsed" IsHitTestVisible="False"
                                           Text="&#x2605;" FontFamily="Segoe UI Symbol" FontSize="16"
                                           Foreground="{DynamicResource MixedRatingBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,8,0" />

                                <Border x:Name="SelectionBorder" Style="{StaticResource LayluCardShape}"
                                        BorderThickness="2" BorderBrush="{DynamicResource GlyphBrush}"
                                        Visibility="Collapsed" />

                                <!-- Running marker, so the state does not depend on the glow alone -->
                                <Border x:Name="RunningMark" Visibility="Collapsed" IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                        Padding="6,2,7,2" CornerRadius="9"
                                        Background="{DynamicResource PositiveRatingBrush}">
                                    <TextBlock Text="&#xec74;" FontFamily="{StaticResource FontIcoFont}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextBrushDark}" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Name="GameControls" Visibility="Collapsed"
                                            Tag="{DynamicResource LayluCardPlayButton}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Name="PART_ButtonPlay" Width="48" Height="48" FontSize="22"
                                            IsTabStop="False" Cursor="Hand"
                                            Content="&#xec74;" FontFamily="{StaticResource FontIcoFont}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource GlyphBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                                                <Setter Property="Opacity" Value="0.9" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Ellipse Fill="{TemplateBinding Background}" />
                                                                <TextBlock Text="{TemplateBinding Content}"
                                                                           FontFamily="{TemplateBinding FontFamily}"
                                                                           FontSize="{TemplateBinding FontSize}"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- Kept for Playnite; not shown, the details panel is always open -->
                                    <Button Name="PART_ButtonInfo" Style="{StaticResource SimpleButton}"
                                            Visibility="Collapsed"
                                            Content="&#xef4f;" FontFamily="{StaticResource FontIcoFont}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,5,2,5"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="&#xef08;" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="DimOverlay" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningGlow"/>
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningMark"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver"/>
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls"/>
                            <Setter Property="Visibility" Value="Visible" TargetName="Glow"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionBorder"/>
                            <Setter Property="Visibility" Value="Visible" TargetName="Glow"/>
                        </DataTrigger>

                        <!-- Options. These come last so they win over the state triggers above -->
                        <Trigger SourceName="GameControls" Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GameControls"/>
                        </Trigger>
                        <Trigger SourceName="DimOverlay" Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glow"/>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RunningGlow"/>
                        </Trigger>
                        <!-- Performance mode: no glow, and a square outline to match the square covers -->
                        <Trigger SourceName="BorderMouseOver" Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glow"/>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RunningGlow"/>
                            <Setter Property="CornerRadius" Value="0" TargetName="SelectionBorder"/>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ImageRotater_Cover"/>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Favorite}" Value="True" />
                                <Condition Binding="{Binding Tag, ElementName=FavouriteMark}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="FavouriteMark"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
